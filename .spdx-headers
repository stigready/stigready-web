# Read by scripts/check-spdx-headers.py (the copyright-header guard, CINC control web-copyright-headers).
# The first licence is what --fix writes; a file may carry any listed one.
license LicenseRef-StigReady-Proprietary
# Third-party, kept under its upstream notice (see NOTICE).
exclude assets/vendor/**
# Generated by scripts/build-css.sh (Tailwind); its inputs carry the header.
exclude assets/css/site.css
# Test fixtures compared byte for byte.
exclude cinc/profiles/*/files/**
# Pipeline config, edited by many branches; not a source file.
exclude .cairn.yml
